# Copy to .env on VM1 (infra/04-jenkins.sh generates it). NEVER commit .env.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=   # generated on VM1, read it with: ssh ... sudo grep PASSWORD /opt/jenkins/.env
DOCKERHUB_USER=shawnraj07
DOCKERHUB_TOKEN=          # Docker Hub access token (Account settings > Personal access tokens, Read & Write)
DOCKER_GID=               # host docker group id, filled automatically
JENKINS_URL=http://<vm1-fqdn>:8080/
GITHUB_REPO_URL=https://github.com/ShawnDCS/software-deployment-group-4
TEST_HOST=10.40.1.20
PROD_HOST=10.40.1.30
PROD_PUBLIC_URL=http://<vm3-fqdn>
